{
  "name": "UserProgress",
  "type": "object",
  "properties": {
    "game": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "level": {
      "type": "integer"
    },
    "streak": {
      "type": "integer"
    },
    "totalCorrect": {
      "type": "integer"
    },
    "totalAttempts": {
      "type": "integer"
    },
    "accuracy": {
      "type": "integer"
    },
    "responseTimeMs": {
      "type": "integer"
    }
  },
  "required": [
    "game",
    "date"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}