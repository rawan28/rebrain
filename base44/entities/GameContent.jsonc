{
  "name": "GameContent",
  "type": "object",
  "properties": {
    "game": {
      "type": "string",
      "description": "The game this content is for, e.g. word_spell, trivia, memory"
    },
    "lang": {
      "type": "string",
      "enum": [
        "he",
        "ar"
      ],
      "default": "he"
    },
    "title": {
      "type": "string",
      "description": "A short friendly title for this content set"
    },
    "content": {
      "type": "string",
      "description": "JSON-encoded content items, e.g. word pairs or quiz questions"
    }
  },
  "required": [
    "game",
    "lang",
    "title",
    "content"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}